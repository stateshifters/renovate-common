{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "automerge": true,
      "semanticCommitType": "chore",
      "groupName": "react monorepo"
    },
    {
      "matchPackageNames": [
        "react-email{/,}**",
        "@react-email{/,}**"
      ],
      "automerge": true,
      "groupName": "react email dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    }
  ]
}
