{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "dependencyDashboardTitle": "Dependencies needing attention",
  "description": "Common renovate config for Stateshifter Labs Projects",
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "cargo",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "gomod",
    "gradle",
    "gradle-wrapper",
    "npm",
    "nvm",
    "pip_requirements",
    "pipenv",
    "poetry",
    "terraform",
    "terraform-version",
    "tflint-plugin"
  ],
  "extends": [
    "config:recommended",
    "github>stateshifters/renovate-common:basics",
    "github>stateshifters/renovate-common:aws",
    "github>stateshifters/renovate-common:biome",
    "github>stateshifters/renovate-common:common-tooling",
    "github>stateshifters/renovate-common:conform",
    "github>stateshifters/renovate-common:docker",
    "github>stateshifters/renovate-common:esbuild",
    "github>stateshifters/renovate-common:eslint",
    "github>stateshifters/renovate-common:engines",
    "github>stateshifters/renovate-common:github",
    "github>stateshifters/renovate-common:gradle",
    "github>stateshifters/renovate-common:golang",
    "github>stateshifters/renovate-common:i18next",
    "github>stateshifters/renovate-common:langfuse",
    "github>stateshifters/renovate-common:postcss",
    "github>stateshifters/renovate-common:posthog",
    "github>stateshifters/renovate-common:python",
    "github>stateshifters/renovate-common:react",
    "github>stateshifters/renovate-common:remix",
    "github>stateshifters/renovate-common:rust",
    "github>stateshifters/renovate-common:solidjs",
    "github>stateshifters/renovate-common:storybook",
    "github>stateshifters/renovate-common:stylelint",
    "github>stateshifters/renovate-common:testing",
    "github>stateshifters/renovate-common:terraform",
    "github>stateshifters/renovate-common:vite",
    "github>stateshifters/renovate-common:webpack",
    ":rebaseStalePrs",
    "mergeConfidence:all-badges"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.*/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+) depName=(?<depName>[^\\s]+)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: registryUrl=(?<registryUrl>[^\\s]+))?\\r?\\n(?:export[ \\t]+)?[A-Za-z0-9_]+_VERSION[ \\t]*[:?]?=[ \\t]*(?<currentValue>[A-Za-z0-9][A-Za-z0-9._+:/-]*)[ \\t]*(?:\\r?\\n|$)",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+) depName=(?<depName>[^\\s]+)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: registryUrl=(?<registryUrl>[^\\s]+))?\\r?\\n(?:export[ \\t]+)?[A-Za-z0-9_]+_VERSION[ \\t]*[:?]?=[ \\t]*\\\"(?<currentValue>[A-Za-z0-9][A-Za-z0-9._+:/-]*)\\\"[ \\t]*(?:\\r?\\n|$)",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+) depName=(?<depName>[^\\s]+)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: registryUrl=(?<registryUrl>[^\\s]+))?\\r?\\n(?:export[ \\t]+)?[A-Za-z0-9_]+_VERSION[ \\t]*[:?]?=[ \\t]*'(?<currentValue>[A-Za-z0-9][A-Za-z0-9._+:/-]*)'[ \\t]*(?:\\r?\\n|$)"
      ]
    }
  ],
  "reviewersFromCodeOwners": false,
  "minimumReleaseAge": "7d",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "groupName": "vulnerability updates",
    "semanticCommitType": "fix"
  },
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "commitHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "separateMajorMinor": true,
  "rebaseWhen": "auto",
  "pin": {
    "rebaseWhen": "auto"
  },
  "schedule": [
    "at any time"
  ],
  "semanticCommitType": "chore",
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "auto",
    "rebaseWhen": "auto",
    "branchTopic": "lock-file-maintenance",
    "commitMessageAction": "Lock file maintenance",
    "semanticCommitType": "chore",
    "extends": [
      "schedule:earlyMondays"
    ],
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "groupName": null,
    "prBodyDefinitions": {
      "Change": "All locks refreshed"
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "matchDatasources": ["!pypi"],
      "minimumReleaseAge": null,
      "automerge": true,
      "commitMessageAction": "pin",
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Require manual merging for Terraform and TFLint, including pins",
      "matchManagers": ["terraform", "terraform-version", "tflint-plugin"],
      "automerge": false
    },
    {
      "description": "Require manual merging for Terraform images and Terraform-related actions",
      "matchPackageNames": [
        "hashicorp/terraform",
        "docker.io/hashicorp/terraform",
        "index.docker.io/hashicorp/terraform",
        "registry-1.docker.io/hashicorp/terraform",
        "hashicorp/setup-terraform",
        "terraform-linters/**"
      ],
      "automerge": false
    },
    {
      "description": "Allow Debian packages and container images without release timestamps",
      "matchDatasources": ["deb", "docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Require manual merging for major updates, including grouped packages",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Require manual merging for dependencies still below 1.0.0",
      "matchCurrentVersion": "<1.0.0",
      "automerge": false
    }
  ]
}
