{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDepTypes": [
        "engines"
      ],
      "automerge": true,
      "rangeStrategy": "widen"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager",
        "devEngines.packageManager"
      ],
      "groupName": "{{{depName}}} package manager",
      "rangeStrategy": "pin",
      "separateMajorMinor": true
    }
  ]
}
