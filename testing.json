{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "groupName": "testing library dependencies",
      "matchPackageNames": [
        "@testing-library{/,}**",
        "@types/testing-library{/,}**"
      ]
    },
    {
      "matchPackageNames": [
        "jest{/,}**"
      ],
      "groupName": "jest monorepo"
    },
    {
      "matchPackageNames": [
        "jsdom{/,}**"
      ],
      "groupName": "jsdom dependencies"
    }
  ]
}
