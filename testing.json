{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "automerge": true,
      "groupName": "testing library dependencies",
      "matchPackageNames": [
        "@testing-library{/,}**",
        "@types/testing-library{/,}**"
      ]
    },
    {
      "matchPackageNames": [
        "vite{/,}**",
        "@vitejs{/,}**",
        "vitest{/,}**",
        "@vitest{/,}**",
        "c8"
      ],
      "automerge": true,
      "groupName": "vitest dependencies"
    },
    {
      "matchPackageNames": [
        "jest{/,}**"
      ],
      "automerge": true,
      "groupName": "jest dependencies"
    },
    {
      "matchPackageNames": [
        "jsdom{/,}**"
      ],
      "automerge": true,
      "groupName": "jsdom dependencies"
    }
  ]
}
