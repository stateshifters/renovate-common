{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "SECURITY"
    ]
  },
  "packageRules": [
    {
      "abandonmentThreshold": "1 year",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchCurrentVersion": "<1.0.0",
      "addLabels": ["v0 releases"],
      "description": "Do not automerge releases that are less than 1.0.0. They are highly likely to be breaking changes."
    },
    {
      "matchDepTypes": ["devDependencies"],
      "addLabels": ["dev dependencies"],
      "prPriority": 10
    },
    {
      "matchDepTypes": ["dependencies"],
      "addLabels": ["runtime dependencies"],
      "prPriority": 5
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "prPriority": 15
    },
    {
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "prPriority": 6
    }
  ]
}
