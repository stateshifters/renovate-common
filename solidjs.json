{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": [
        "solid-js",
        "@solidjs{/,}**",
        "solid-start{/,}**",
        "vite-plugin-solid"
      ],
      "automerge": true,
      "semanticCommitType": "fix",
      "groupName": "solidjs dependencies"
    }
  ]
}
