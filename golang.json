{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "gomod": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Preserve the Go minimum compatibility version instead of pinning it",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "auto"
    },
    {
      "matchCurrentVersion": "<1.0.0",
      "description": "Golang's ecosystem is still evolving, so we want to ensure that we are always using the latest version of the dependencies.",
      "matchManagers": [
        "gomod"
      ],
      "enabled": true,
      "automerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "constraintsFiltering": "strict",
      "enabled": true,
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "enabled": true
    }
  ]
}
