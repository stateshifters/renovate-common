{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Biome dependency management",
  "extends": [
    "customManagers:biomeVersions"
  ],
  "packageRules": [
    {
      "description": "Wait until both Biome packages have eligible updates",
      "groupName": "biome dependencies",
      "minimumGroupSize": 2,
      "matchPackageNames": [
        "@biomejs/biome",
        "@meza/biome"
      ]
    }
  ]
}
